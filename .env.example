# Bu dosyayı ".env" adıyla kopyala ve değerleri doldur. .env repoya girmez.
# Çalıştırma: flutter run --dart-define-from-file=.env
SUPABASE_URL=https://PROJE_KIMLIGI.supabase.co
# Publishable anahtar (sb_publishable_...). ASLA secret (sb_secret_) / service_role değil!
SUPABASE_PUBLISHABLE_KEY=
# Google Cloud > Credentials > "Web application" istemci kimliği (xxx.apps.googleusercontent.com)
GOOGLE_WEB_CLIENT_ID=
