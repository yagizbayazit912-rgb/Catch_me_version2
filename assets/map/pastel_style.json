{
  "version": 8,
  "name": "CatchMe Pastel",
  "sources": {
    "openmaptiles": { "type": "vector", "url": "https://tiles.openfreemap.org/planet" }
  },
  "layers": [
    { "id": "background", "type": "background", "paint": { "background-color": "#FFFBF5" } },
    { "id": "landcover-green", "type": "fill", "source": "openmaptiles", "source-layer": "landcover",
      "filter": ["in", "class", "grass", "wood", "farmland"],
      "paint": { "fill-color": "#DFF5EA", "fill-opacity": 0.8 } },
    { "id": "park", "type": "fill", "source": "openmaptiles", "source-layer": "park",
      "paint": { "fill-color": "#CDEFE0" } },
    { "id": "water", "type": "fill", "source": "openmaptiles", "source-layer": "water",
      "paint": { "fill-color": "#CFE8FA" } },
    { "id": "building", "type": "fill", "source": "openmaptiles", "source-layer": "building", "minzoom": 14,
      "paint": { "fill-color": "#F6E9DC", "fill-opacity": 0.9 } },
    { "id": "road-minor", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["in", "class", "minor", "service", "track", "path"], "minzoom": 13,
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#FFFFFF",
        "line-width": ["interpolate", ["linear"], ["zoom"], 13, 0.6, 18, 6] } },
    { "id": "road-major", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["in", "class", "primary", "secondary", "tertiary", "trunk", "motorway"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#FFFFFF",
        "line-width": ["interpolate", ["linear"], ["zoom"], 6, 0.6, 18, 12] } }
  ]
}
